# Copia este archivo a .env y ajusta los valores. .env no se sube al repositorio.

# URL base del backend (incluye el prefijo /api).
VITE_API_BASE_URL=http://localhost:8000/api

# Modo de autenticación. Debe coincidir con AUTH_MODE del backend.
#   dev      -> login provisional por ID de usuario, sin autenticación real.
#               SOLO para desarrollo: un build de producción con "dev" no arranca.
#   keycloak -> inicio de sesión con Keycloak (token Bearer).
# Si no se define, vale "keycloak".
VITE_AUTH_MODE=dev

# Keycloak (obligatorias solo con VITE_AUTH_MODE=keycloak).
# Cliente público con PKCE. Keycloak exige abrir la app por localhost o HTTPS.
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=mi-aplicacion
VITE_KEYCLOAK_CLIENT_ID=frontend-client

# Tamaño máximo por archivo en MB (de 1 a 10).
VITE_MAX_FILE_SIZE_MB=10
